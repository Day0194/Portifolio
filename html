<input type="file" id="file" accept="image/*" class="hidden">

<script>
(function () {
  var KEY = 'portfolio-v1';
  var els = Array.prototype.slice.call(document.querySelectorAll('[data-e]'));
  var imgs = Array.prototype.slice.call(document.querySelectorAll('[data-img]'));
  var links = Array.prototype.slice.call(document.querySelectorAll('a[data-link]'));
  var body = document.body, editing = false, pickTarget = null;

  // Restaurar conteúdo salvo
  try {
    var saved = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (saved) {
      els.forEach(function (el, i) { if (saved.t && saved.t[i] != null) el.innerHTML = saved.t[i]; });
      imgs.forEach(function (el, i) { if (saved.i && saved.i[i]) setImg(el, saved.i[i]); });
      links.forEach(function (el, i) { if (saved.l && saved.l[i]) el.setAttribute('href', saved.l[i]); });
    }
  } catch (e) {}

  function setImg(el, src) {
    el.innerHTML = '<img src="' + src + '" alt="" class="h-full w-full object-cover">';
    el.setAttribute('data-src', src);
  }

  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify({
        t: els.map(function (el) { return el.innerHTML; }),
        i: imgs.map(function (el) { return el.getAttribute('data-src') || ''; }),
        l: links.map(function (el) { return el.getAttribute('href'); })
      }));
    } catch (e) {}
  }

  function setEditing(on) {
    editing = on;
    body.classList.toggle('editing', on);
    els.forEach(function (el) { on ? el.setAttribute('contenteditable', 'true') : el.removeAttribute('contenteditable'); });
    document.getElementById('toggle').textContent = on ? 'Concluir edição' : 'Editar site';
    ['export', 'reset'].forEach(function (id) { document.getElementById(id).classList.toggle('hidden', !on); });
    if (!on) save();
  }

  document.getElementById('toggle').addEventListener('click', function () { setEditing(!editing); });
  document.addEventListener('input', function (e) { if (editing && e.target.hasAttribute('data-e')) save(); });

  // Em modo de edição, links pedem o novo endereço em vez de navegar
  links.forEach(function (a) {
    a.addEventListener('click', function (e) {
      if (!editing) return;
      e.preventDefault();
      var v = prompt('Endereço do link:', a.getAttribute('href'));
      if (v !== null) { a.setAttribute('href', v); save(); }
    });
  });
  document.querySelectorAll('a[data-e]').forEach(function (a) {
    a.addEventListener('click', function (e) { if (editing) e.preventDefault(); });
  });

  // Trocar imagens dos projetos
  var file = document.getElementById('file');
  imgs.forEach(function (box) {
    box.addEventListener('click', function () { if (editing) { pickTarget = box; file.click(); } });
  });
  file.addEventListener('change', function () {
    var f = file.files[0]; if (!f || !pickTarget) return;
    var r = new FileReader();
    r.onload = function () { setImg(pickTarget, r.result); save(); file.value = ''; };
    r.readAsDataURL(f);
  });

  document.getElementById('reset').addEventListener('click', function () {
    if (confirm('Apagar todas as edições e voltar ao texto original?')) { localStorage.removeItem(KEY); location.reload(); }
  });

  // Exportar HTML final já editado
  document.getElementById('export').addEventListener('click', function () {
    setEditing(false);
    var clone = document.documentElement.cloneNode(true);
    ['bar', 'file'].forEach(function (id) { var n = clone.querySelector('#' + id); if (n) n.remove(); });
    clone.querySelectorAll('script:not([src])').forEach(function (s) { if (s.textContent.indexOf('portfolio-v1') > -1) s.remove(); });
    clone.querySelectorAll('.reveal').forEach(function (n) { n.classList.add('in'); });
    var blob = new Blob(['<!DOCTYPE html>\n' + clone.outerHTML], { type: 'text/html' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = 'index.html'; a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
  });

  // Animação de entrada ao rolar
  var items = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { threshold: 0.12 });
    items.forEach(function (n) { io.observe(n); });
  } else { items.forEach(function (n) { n.classList.add('in'); }); }
})();
</script>
