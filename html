<script>
(function () {
  var KEY = 'portfolio-maria-v1';
  var all = function (q) { return Array.prototype.slice.call(document.querySelectorAll(q)); };
  var els = all('[data-e]:not([data-new])').concat(all('[data-e][data-new]'));
  var imgs = all('[data-img]:not([data-new])').concat(all('[data-img][data-new]'));
  var links = all('a[data-link]:not([data-new])').concat(all('a[data-link][data-new]'));
  var body = document.body, editing = false, pickTarget = null;
  var srcs = imgs.map(function () { return []; });

  // Restaurar conteúdo salvo
  try {
    var saved = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (saved) {
      els.forEach(function (el, i) { if (saved.t && saved.t[i] != null) el.innerHTML = saved.t[i]; });
      links.forEach(function (el, i) {
        // Na primeira abertura desta versão, os botões de contato usam os links novos
        if (saved.l && saved.l[i] && !(el.hasAttribute('data-contact') && saved.v !== 2)) el.setAttribute('href', saved.l[i]);
      });
      if (saved.v !== 2) save();
    }
  } catch (e) {}

  // Imagens: lê o formato novo (lista por projeto) ou o antigo (uma imagem por projeto)
  var imgSaved = null;
  try { imgSaved = JSON.parse(localStorage.getItem(KEY + '-img') || 'null'); } catch (e) {}
  var si = imgSaved || (saved && saved.i) || [];
  si.forEach(function (v, i) { if (i < srcs.length) srcs[i] = Array.isArray(v) ? v.slice() : (v ? [v] : []); });

  function render(i) {
    var box = imgs[i], list = srcs[i], h = '';
    box.classList.add('relative');
    if (!list.length) {
      h = '<span>Imagem do projeto</span>';
    } else {
      h = '<div class="gal absolute inset-0 flex snap-x snap-mandatory overflow-x-auto" style="scrollbar-width:none">' +
        list.map(function (s, k) {
          return '<div class="relative h-full w-full shrink-0 snap-center"><img src="' + s + '" alt="Imagem ' + (k + 1) + ' do projeto" loading="lazy" class="h-full w-full object-cover">' +
            '<button type="button" data-rm="' + k + '" class="edit-only absolute left-2 top-2 h-8 w-8 items-center justify-center rounded-full bg-ink/80 text-lg leading-none text-bone hover:bg-red-600" aria-label="Remover imagem">×</button></div>';
        }).join('') + '</div>';
      if (list.length > 1) {
        h += '<button type="button" data-nav="-1" class="absolute left-2 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-ink/70 text-bone hover:bg-em hover:text-ink" aria-label="Imagem anterior">‹</button>' +
          '<button type="button" data-nav="1" class="absolute right-2 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-ink/70 text-bone hover:bg-em hover:text-ink" aria-label="Próxima imagem">›</button>' +
          '<span class="gal-count absolute bottom-2 left-1/2 -translate-x-1/2 rounded-full bg-ink/70 px-3 py-1 text-xs text-bone">1 / ' + list.length + '</span>';
      }
    }
    h += '<button type="button" data-add class="edit-only absolute bottom-2 right-2 rounded-full bg-em px-3 py-1.5 text-xs font-semibold text-ink hover:bg-emd">+ Adicionar imagens</button>';
    box.innerHTML = h;
  }
  imgs.forEach(function (_, i) { render(i); });
  if (!imgSaved && saved && saved.i && saved.i.some(Boolean)) saveImgs();

  function shrink(f) {
    return new Promise(function (res) {
      var r = new FileReader();
      r.onload = function () {
        var im = new Image();
        im.onload = function () {
          var sc = Math.min(1, 1400 / im.width), c = document.createElement('canvas');
          c.width = Math.round(im.width * sc); c.height = Math.round(im.height * sc);
          c.getContext('2d').drawImage(im, 0, 0, c.width, c.height);
          res(c.toDataURL('image/jpeg', 0.82));
        };
        im.onerror = function () { res(null); };
        im.src = r.result;
      };
      r.onerror = function () { res(null); };
      r.readAsDataURL(f);
    });
  }

  var warned = false;
  function saveImgs() {
    try { localStorage.setItem(KEY + '-img', JSON.stringify(srcs)); }
    catch (e) { if (!warned) { warned = true; alert('As imagens ocupam espaço demais no navegador e não foram salvas. Remova algumas ou use menos imagens por projeto.'); } }
  }

  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify({
        t: els.map(function (el) { return el.innerHTML; }),
        l: links.map(function (el) { return el.getAttribute('href'); }),
        v: 2
      }));
    } catch (e) {}
  }

  function setEditing(on) {
    editing = on;
    body.classList.toggle('editing', on);
    els.forEach(function (el) { on ? el.setAttribute('contenteditable', 'true') : el.removeAttribute('contenteditable'); });
    document.getElementById('toggle').textContent = on ? 'Concluir edição' : 'Editar site';
    ['export', 'reset'].forEach(function (id) { document.getElementById(id).classList.toggle('hidden', !on); });
    if (!on) save();
  }

  document.getElementById('toggle').addEventListener('click', function () { setEditing(!editing); });
  document.addEventListener('input', function (e) { if (editing && e.target.hasAttribute('data-e')) save(); });

  // Em modo de edição, links pedem o novo endereço em vez de navegar
  links.forEach(function (a) {
    a.addEventListener('click', function (e) {
      if (!editing) return;
      e.preventDefault();
      var v = prompt('Endereço do link:', a.getAttribute('href'));
      if (v !== null) { a.setAttribute('href', v); save(); }
    });
  });
  document.querySelectorAll('a[data-e]').forEach(function (a) {
    a.addEventListener('click', function (e) { if (editing) e.preventDefault(); });
  });

  // Trocar imagens dos projetos
  var file = document.getElementById('file');
  imgs.forEach(function (box, i) {
    box.addEventListener('click', function (e) {
      if (!editing) return;
      var rm = e.target.closest('[data-rm]');
      if (rm) { srcs[i].splice(+rm.getAttribute('data-rm'), 1); render(i); saveImgs(); return; }
      if (e.target.closest('[data-add]') || !srcs[i].length) { pickTarget = i; file.click(); }
    });
  });
  file.addEventListener('change', function () {
    var fl = Array.prototype.slice.call(file.files), idx = pickTarget;
    if (!fl.length || idx == null) return;
    Promise.all(fl.map(shrink)).then(function (r) {
      r.forEach(function (d) { if (d) srcs[idx].push(d); });
      render(idx); saveImgs(); file.value = '';
    });
  });

  document.getElementById('reset').addEventListener('click', function () {
    if (confirm('Apagar todas as edições e voltar ao texto original?')) { localStorage.removeItem(KEY); location.reload(); }
  });

  // Exportar HTML final já editado
  document.getElementById('export').addEventListener('click', function () {
    setEditing(false);
    var clone = document.documentElement.cloneNode(true);
    ['bar', 'file'].forEach(function (id) { var n = clone.querySelector('#' + id); if (n) n.remove(); });
    clone.querySelectorAll('script:not([src])').forEach(function (s) { if (s.textContent.indexOf('portfolio-maria-v1') > -1) s.remove(); });
    clone.querySelectorAll('.edit-only').forEach(function (n) { n.remove(); });
    clone.querySelectorAll('a[data-link][hidden]').forEach(function (n) { n.remove(); });
    clone.querySelectorAll('.reveal').forEach(function (n) { n.classList.add('in'); });
    var blob = new Blob(['<!DOCTYPE html>\n' + clone.outerHTML], { type: 'text/html' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = 'index.html'; a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
  });

  // Animação de entrada ao rolar
  var items = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { threshold: 0.12 });
    items.forEach(function (n) { io.observe(n); });
  } else { items.forEach(function (n) { n.classList.add('in'); }); }
})();
</script>
<script>
(function () {
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-nav]'); if (!b) return;
    var g = b.parentNode.querySelector('.gal');
    if (g) g.scrollBy({ left: +b.getAttribute('data-nav') * g.clientWidth, behavior: 'smooth' });
  });
  document.addEventListener('scroll', function (e) {
    var g = e.target; if (!g.classList || !g.classList.contains('gal')) return;
    var c = g.parentNode.querySelector('.gal-count');
    if (c) c.textContent = (Math.round(g.scrollLeft / g.clientWidth) + 1) + ' / ' + g.children.length;
  }, true);
})();
</script>
</body>
